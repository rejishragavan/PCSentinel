<Window x:Class="PCSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PCSentinel.App.ViewModels"
        mc:Ignorable="d"
        Title="PC Sentinel — Hardware Health &amp; Diagnostics"
        Height="780" Width="1100"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:DashboardViewModel />
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PC SENTINEL" Foreground="{StaticResource AccentCyan}" FontSize="24" FontWeight="Bold" />
                        <Border Background="#334155" CornerRadius="6" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsSimulating, Converter={x:Null}, StringFormat='Mode: {0}'}" 
                                       Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Continuous Hardware Telemetry, Personalized Baselines &amp; Root-Cause Diagnostics" 
                               Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Health Score Badge -->
                <Border Grid.Column="1" Background="#0F172A" BorderBrush="{Binding HealthColor}" BorderThickness="2" CornerRadius="12" Padding="20,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="HEALTH SCORE" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding HealthSummary}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HealthScore}" Foreground="{Binding HealthColor}" FontSize="32" FontWeight="Black" VerticalAlignment="Center"/>
                        <TextBlock Text="/100" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="PROCESSOR (CPU)" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Temperature" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F1} °C'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Core Clock" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding CpuClock, StringFormat='{}{0:F0} MHz'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Package Power" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding CpuPower, StringFormat='{}{0:F1} W'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Total Load" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding CpuLoad, StringFormat='{}{0:F0} %'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GPU Card -->
            <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="GRAPHICS (GPU)" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Core / Hotspot" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F1} °C'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text=" / " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock Text="{Binding GpuHotspot, StringFormat='{}{0:F1} °C'}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Clock / Fan" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding GpuClock, StringFormat='{}{0:F0} MHz'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <TextBlock Text="{Binding GpuFan, StringFormat='{}{0:F0}% Fan'}" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Power Draw" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding GpuPower, StringFormat='{}{0:F1} W'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Core Load" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding GpuLoad, StringFormat='{}{0:F0} %'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RAM & Storage Card -->
            <Border Grid.Column="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="MEMORY &amp; SYSTEM" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="RAM Used" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding RamUsedGb, StringFormat='{}{0:F1} GB'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="RAM Utilization" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="{Binding RamLoad, StringFormat='{}{0:F1} %'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Diagnostic Engine" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <TextBlock Text="Multi-Signal Active" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Button Content="Simulate Throttle Incident" Command="{Binding ToggleSimulationModeCommand}" 
                            Background="#334155" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,4" Margin="0,4,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Diagnostic Insights & Incident Feed -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="ROOT-CAUSE DIAGNOSTICS &amp; ANOMALIES" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text=" (Learned Baseline vs Current Hardware Telemetry)" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Active Events List -->
                <ListView Grid.Row="1" ItemsSource="{Binding ActiveEvents}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity Badge -->
                                    <Border Grid.Column="0" Background="#991B1B" CornerRadius="6" Padding="8,4" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Severity}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Recommended Action: " Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Recommendation}" Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Confidence -->
                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CONFIDENCE" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Confidence, StringFormat='{}{0:P0}'}" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
