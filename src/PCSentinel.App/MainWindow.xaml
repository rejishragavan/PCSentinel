<Window x:Class="PCSentinel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PCSentinel.App.ViewModels"
        mc:Ignorable="d"
        Title="PC Sentinel — Hardware Health, Baseline &amp; Diagnostics"
        Height="820" Width="1160"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:DashboardViewModel />
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Status Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PC SENTINEL" Foreground="{StaticResource AccentCyan}" FontSize="24" FontWeight="Bold" />

                        <!-- Workload Badge -->
                        <Border Background="#4338CA" CornerRadius="6" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WorkloadName, StringFormat='WORKLOAD: {0}'}" 
                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <!-- Hardware Provider Status -->
                        <Border Background="#334155" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsSimulating, Converter={x:Null}, StringFormat='Mode: {0}'}" 
                                       Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding WorkloadDescription}" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                        <TextBlock Text=" • " Foreground="{StaticResource TextSecondary}" FontSize="13" />
                        <TextBlock Text="{Binding BaselineComparisonText}" Foreground="{StaticResource AccentGreen}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Health Score Badge -->
                <Border Grid.Column="1" Background="#0F172A" BorderBrush="{Binding HealthColor}" BorderThickness="2" CornerRadius="12" Padding="20,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="HEALTH SCORE" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding HealthSummary}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HealthScore}" Foreground="{Binding HealthColor}" FontSize="32" FontWeight="Black" VerticalAlignment="Center"/>
                        <TextBlock Text="/100" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Metric Cards with Live History Sparklines -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="PROCESSOR (CPU)" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F1} °C'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Real-Time Sparkline Canvas -->
                    <Border Background="#0F172A" CornerRadius="6" Height="55" Margin="0,0,0,12" Padding="4">
                        <Canvas ClipToBounds="True">
                            <Polyline Points="{Binding CpuSparkline}" Stroke="{StaticResource AccentCyan}" StrokeThickness="2" />
                        </Canvas>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Core Clock" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding CpuClock, StringFormat='{}{0:F0} MHz'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Package Power" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding CpuPower, StringFormat='{}{0:F1} W'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Core Load" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding CpuLoad, StringFormat='{}{0:F0} %'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GPU Card -->
            <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="GRAPHICS (GPU)" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F1} °C'}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Real-Time Sparkline Canvas -->
                    <Border Background="#0F172A" CornerRadius="6" Height="55" Margin="0,0,0,12" Padding="4">
                        <Canvas ClipToBounds="True">
                            <Polyline Points="{Binding GpuSparkline}" Stroke="{StaticResource AccentGreen}" StrokeThickness="2" />
                        </Canvas>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Hotspot / Fan" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding GpuHotspot, StringFormat='{}{0:F1} °C'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="{Binding GpuFan, StringFormat='{}{0:F0}%'}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Core Clock" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding GpuClock, StringFormat='{}{0:F0} MHz'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Power / Load" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding GpuLoad, StringFormat='{}{0:F0} %'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RAM & Test Controls Card -->
            <Border Grid.Column="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="SYSTEM &amp; SENTINEL NODE" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="RAM Used" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding RamUsedGb, StringFormat='{}{0:F1} GB'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="RAM Saturation" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding RamLoad, StringFormat='{}{0:F1} %'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Hardware Bus" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock Text="USB-C Serial Active" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="Cycle Workload (Idle / Gaming / Throttle)" 
                            Command="{Binding CycleSimulationProfileCommand}" 
                            Background="#334155" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="10,6" Margin="0,4,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Root-Cause Diagnostics, Evidence & Alerts Feed -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="ROOT-CAUSE CORRELATION ENGINE" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text=" (Explainable Multi-Signal Anomaly Diagnosis)" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Active Events List -->
                <ListView Grid.Row="1" ItemsSource="{Binding ActiveEvents}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity Badge -->
                                    <Border Grid.Column="0" Background="#991B1B" CornerRadius="6" Padding="8,4" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Severity}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Recommended Action: " Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Recommendation}" Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Confidence -->
                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="CONFIDENCE" Foreground="{StaticResource TextSecondary}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Confidence, StringFormat='{}{0:P0}'}" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
