<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>PCSentinel.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCSentinel.Core\PCSentinel.Core.csproj" />
    <ProjectReference Include="..\PCSentinel.Hardware\PCSentinel.Hardware.csproj" />
    <ProjectReference Include="..\PCSentinel.Storage\PCSentinel.Storage.csproj" />
    <ProjectReference Include="..\PCSentinel.Analysis\PCSentinel.Analysis.csproj" />
    <ProjectReference Include="..\PCSentinel.Diagnostics\PCSentinel.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

</Project>
